# 복사해서 .env 로 쓰기 (.env 는 깃에 안 올라감). 키는 여기 넣지 말고 aws configure --profile 로.
AWS_PROFILE=fintris-jeff
AWS_REGION=ap-northeast-2
JEFF_REQUESTS_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정번호>/fintris-dev-jeff-requests
JEFF_URL=http://127.0.0.1:8765
# 비우면 jeff-serve 기본 모델. 학습한 어댑터 이름을 넣으면 그걸로 판단
JEFF_MODEL=
# 학습 때 쓴 지시문·선택지 (웹 UI 프로필). 비우면 요청에 options 가 꼭 있어야 함
JEFF_PROMPT_FILE=
JEFF_TIMEOUT=30

# sLM 워커 (python -m workers.slm). 프롬프트·주소·키는 서버가 아니라 여기에만
SLM_REQUESTS_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정번호>/fintris-dev-slm-requests
# OpenAI 호환 주소 (지금 수업 Qwen, 나중에 승현 vLLM). 수업 서버엔 실제 거래를 보내지 말 것
SLM_URL=
SLM_API_KEY=
SLM_MODEL=
# v1·v2·v3 (workers/slm.py PROMPTS)
SLM_PROMPT=v3
SLM_TIMEOUT=30
