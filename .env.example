FINTRIS_INTERNAL_TOKEN = replace-with-long-random-secret


LLM_PROVIDER = "ollama"
LLM_BASE_URL= "http://localhost:11434"
LLM_MODEL= "qwen3.5:9b"
LLM_API_KEY= "<API_KEY>"


# LLM Provider (vLLM은 OpenAI 호환 API 사용)
#LLM_PROVIDER=openai
#LLM_BASE_URL=http://192.168.0.187:8000/v1
# vLLM에서 제공하는 모델 이름
#LLM_MODEL=qwen3.5-9b
# vLLM API Key
#LLM_API_KEY=your-vllm-api-key


# 생성 설정
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_OUTPUT_MODE=json_schema

# 복사해서 .env 로 쓰기. 실제 값(토큰·큐 주소·키)은 깃에 올리지 않는다.

# ---- 필수 ----
# Spring(BE Main) → AI 서버 인증. BE와 같은 값. 아래 FINTRIS_INTERNAL_TOKEN 값과 일치해야 한다.

# ---- 기본 ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- 거래 분류 ----
# 확신이 이 값보다 낮으면 사용자에게 묻는다
CLASSIFY_QUESTION_THRESHOLD=0.7
# 비슷한 이름 매칭 최소 점수 (0~100)
CLASSIFY_FUZZY_MIN_SCORE=90

# ---- 분류 Jeff·sLM (SQS 큐) ----
# 큐 주소를 비우면 그 단계는 꺼지고 규칙·사전만 동작한다 (시연은 비움)
# Jeff는 JEFF_REQUESTS_URL + MODEL_REPLIES_URL, sLM은 SLM_REQUESTS_URL + MODEL_REPLIES_URL 둘 다 있어야 켜진다
# 큐를 켜면 큐 권한이 있는 AWS 자격 증명도 필요하다 (AWS_ACCESS_KEY_ID·AWS_SECRET_ACCESS_KEY 등 boto3 기본 방식)
# sLM(vLLM) 주소·키·프롬프트는 여기가 아니라 큐 건너편 워커 쪽 설정이다
AWS_REGION=ap-northeast-2
JEFF_REQUESTS_URL=
SLM_REQUESTS_URL=
MODEL_REPLIES_URL=

# 답을 기다리는 시간(초). 넘으면 그 거래는 사용자에게 묻는다
JEFF_TIMEOUT=5
SLM_TIMEOUT=10
# 시간 초과·오류 뒤 이 시간(초) 동안 그 단계를 건너뛴다
JEFF_COOLDOWN=60
SLM_COOLDOWN=60
# Jeff의 ask 확률이 이 값 이상이면 sLM 대신 사용자에게 묻는다
JEFF_ASK_THRESHOLD=0.2
